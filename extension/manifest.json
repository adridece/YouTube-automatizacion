{
  "manifest_version": 3,
  "name": "Cerezium Autopilot — Google Flow",
  "version": "2.10.5",
  "description": "Cerezium Autopilot: tus Shorts en piloto automático en Google Flow. Genera las imágenes, anima cada escena y guarda los vídeos numerados en una carpeta nueva por lote.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "notifications",
    "sidePanel",
    "offscreen",
    "alarms",
    "scripting",
    "power",
    "contentSettings",
    "tabCapture",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://app.heygen.com/*",
    "https://*.heygen.com/*",
    "https://*.heygen.ai/*",
    "https://www.mureka.ai/*",
    "https://*.mureka.ai/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cerezium Autopilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.heygen.com/*",
        "https://www.mureka.ai/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.heygen.com/*"
      ],
      "js": [
        "heygen.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mureka.ai/*"
      ],
      "js": [
        "mureka.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "short_name": "Cerezium",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Abrir Cerezium y preparar esta pestaña de Flow"
    }
  }
}
